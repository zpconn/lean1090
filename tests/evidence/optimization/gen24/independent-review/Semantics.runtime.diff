+/-- Derive the standard numeric expressions from the already constructed oracle
+expressions. Only BDS44 temperature changes an expression; BDS30 has no standard
+scalar expressions. Every other register can share the original immutable list. -/
+def commBStandardFloatsFromOracle (register word : Nat)
+    (fields : List NumericField) : List NumericField :=
+  if register == 0x30 then [] else if register == 0x44 then
+    fields.map fun field =>
+      if field.key == "temperature" then
+        { field with value := some (.literal .binary64 (cbSigned word 24 11 / 4)) }
+      else field
+  else fields
+
