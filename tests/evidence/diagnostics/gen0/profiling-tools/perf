#!/bin/sh
# Local extraction only; the Ubuntu /usr/bin/perf wrapper expects a matching kernel package.
profiling_root=$(CDPATH= cd -- "$(dirname -- "$0")/../root" && pwd)
LD_LIBRARY_PATH="$profiling_root/usr/lib/x86_64-linux-gnu${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" 
export LD_LIBRARY_PATH
exec "$profiling_root/usr/lib/linux-tools-6.8.0-147/perf" "$@"
